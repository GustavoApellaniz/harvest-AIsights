# Copy to .env and adjust. Settings are read by app/core/config.py.

# --- LLM (Google Gemini API) ---
GEMINI_API_KEY=your_api_key_here
# Model name sent to the Gemini API
LLM_MODEL=gemini-2.5-flash
# Max output tokens (thinking models count internal reasoning here too)
LLM_MAX_TOKENS=2048
# Sampling temperature, 0 to 2
LLM_TEMPERATURE=0.2
# Timeout per LLM call, in seconds
LLM_TIMEOUT_SECONDS=30.0

# --- Embeddings and vector store ---
# Hugging Face model used for embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Directory where the Chroma DB is persisted
CHROMA_PATH=./chroma_db
# Chroma collection name
COLLECTION_NAME=agri_quotes
# Directory with the source documents to ingest
DATA_DIR=./data

# --- RAG ---
# Characters per chunk (must be >= 100)
CHUNK_SIZE=800
# Characters shared between consecutive chunks (must be < CHUNK_SIZE)
CHUNK_OVERLAP=120
# Number of chunks retrieved per question (1 to 30)
TOP_K=8
# Max cosine distance accepted for a retrieved chunk (lower = more similar).
# Leave commented to disable the filter; if every chunk is filtered out, the LLM is not called.
# MAX_DISTANCE=0.5

# --- In-memory chat history ---
# Conversation turns kept per session
MAX_HISTORY_TURNS=5
# Max number of sessions kept in memory
MAX_SESSIONS=1000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
